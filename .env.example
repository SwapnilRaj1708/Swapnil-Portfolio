# Environment variable NAMES go here, one per line (e.g. NAME=). Values never do.

# Set to 1 to build/serve the dev-only pages /dev/styleguide and /dev/type. Never set on Vercel.
ENABLE_DEV_PAGES=

# Contact flow delivery (PF-019, D-33). Resend API key – required to send; without it the
# endpoint answers "failed" (503) and nothing is sent. Set by the owner in .env.local and in
# Vercel (Production and Preview) only.
RESEND_API_KEY=

# Optional sender, e.g. "Portfolio <hello@your-domain>" once the domain is verified with Resend.
# Default: Resend's test sender "Portfolio <onboarding@resend.dev>" (delivers only to the
# Resend account owner's own address).
CONTACT_EMAIL_FROM=
