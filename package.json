{
  "name": "portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fonts:fetch": "node scripts/fetch-fonts.mjs",
    "predev": "npm run fonts:fetch",
    "dev": "next dev",
    "prebuild": "npm run fonts:fetch",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "review:shots": "npm run build && node scripts/review-shots.mjs",
    "size": "node scripts/size-report.mjs",
    "lighthouse": "npm run build && node scripts/lighthouse.mjs",
    "media:capture": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/capture-project-media.mjs",
    "media:stills": "node scripts/encode-stills.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.1.0",
    "clsx": "2.1.1",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.39.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "jsdom": "31.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "4.1.12"
  }
}
